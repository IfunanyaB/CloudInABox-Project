# Local portal development. The production deployment must override these values.
APP_ENV=development
AUTH_MODE=local
AZURE_PORTAL_DB_PATH=project_outputs/portal.sqlite3

# Hosted public portal (Azure Container Apps + PostgreSQL + Service Bus)
# APP_ENV=production
# AUTH_MODE=admin_key
# PORTAL_ADMIN_KEY=<generate a random secret of at least 32 characters; store in Key Vault>
# MAX_REQUEST_BUDGET_EUR=1000
# PUBLIC_REQUESTS_PER_EMAIL_PER_DAY=2
# DATABASE_URL=postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/<database>?sslmode=require
# SERVICE_BUS_NAMESPACE=https://<namespace>.servicebus.windows.net
# SERVICE_BUS_QUEUE=tenant-provisioning
# AZURE_SUBSCRIPTION_ID=<subscription-guid>
# BUDGET_CONTACT_EMAIL=<operations-email>
