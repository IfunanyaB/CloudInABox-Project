# Local portal development. The production deployment must override these values.
APP_ENV=development
AUTH_MODE=local
AZURE_PORTAL_DB_PATH=project_outputs/portal.sqlite3

# Hosted public portal (Azure Container Apps + PostgreSQL + Service Bus)
# APP_ENV=production
# AUTH_MODE=admin_key
# PORTAL_ADMIN_KEY=<generate a random secret of at least 32 characters; store in Key Vault>
# MAX_REQUEST_BUDGET_EUR=1000
# PUBLIC_REQUESTS_PER_EMAIL_PER_DAY=2
# DATABASE_URL=postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/<database>?sslmode=require
# SERVICE_BUS_NAMESPACE=https://<namespace>.servicebus.windows.net
# SERVICE_BUS_QUEUE=tenant-provisioning
# AZURE_SUBSCRIPTION_ID=<platform subscription GUID>
# AZURE_TENANT_ID=<Microsoft Entra tenant directory GUID>
# BUDGET_CONTACT_EMAIL=<operations-email>
# Tenants are placed into isolated resource groups in the active subscription.
# HUB_SUBSCRIPTION_ID=<platform subscription GUID>
# HUB_RESOURCE_GROUP=rg-cib-hub
# HUB_VNET_NAME=vnet-cib-hub
# HUB_FIREWALL_PRIVATE_IP=<hub firewall private IP, when enabled>
# HUB_VPN_GATEWAY_ENABLED=false
# GITHUB_REPOSITORY=IfunanyaB/FinalYearProject
# GITHUB_ACTIONS_TOKEN=<fine-grained token with repository Contents: write>
# GITHUB_CALLBACK_SECRET=<random secret, at least 32 characters>
